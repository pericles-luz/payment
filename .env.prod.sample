# =============================================================================
# payment — TEMPLATE de configuração de PRODUÇÃO C6 (SIN-69120 / trilha E)
# =============================================================================
# Delta staging→produção do go-live C6 (cliente piloto Verz). Este arquivo
# documenta o SHAPE e os VALORES DE PRODUÇÃO esperados de cada knob. Complementa
# `.env.example` (que descreve o shape genérico em dev); aqui o foco são os
# overrides que TÊM de mudar em prod.
#
# 🔒 REGRAS (não-negociáveis)
#   1. NENHUM valor secreto real neste arquivo. Todos os valores abaixo são
#      placeholders/documentação. É versionado no repo.
#   2. Em produção NENHUM segredo vem de arquivo: tokens, refs de webhook,
#      credenciais e chaves privadas vêm do secret manager / vault, injetados no
#      ambiente do processo no deploy (Regra C1 — ver config.go). NÃO commite
#      `.env` (gitignored).
#   3. Segredo de banco do cliente (credencial/senha C6) NUNCA entra aqui, em
#      issue, e-mail em claro, chat ou log. Ele é entrado pelo OPERADOR direto no
#      console sobre TLS, no cofre keyed (tenant,bank) — write-only, LogValue
#      redigido (runbook docs/ops/go-live-c6-prod.md §1).
#
# Secure-by-default: os defaults do binário mantêm os controles LIGADOS. Em prod
# NÃO deixe knobs de segurança implícitos — declare-os explicitamente aqui como
# checklist auditável.
# =============================================================================

# --- Transporte HTTP -----------------------------------------------------------
# App roda HTTP puro ATRÁS de um proxy que termina TLS (docs/ops/ingress-runbook.md).
PAYMENT_HTTP_ADDR=:8080

# Nº de proxies confiáveis à frente da app. PROD = 1 (um proxy/ingress termina
# TLS e adiciona X-Forwarded-For). Errado (0) = client-IP spoofável → atribuição
# e rate-limit por IP furáveis (SIN-68747). Default do binário: 0 (dev direto).
PAYMENT_TRUSTED_PROXY_HOPS=1

# Cookies só sobre TLS. PROD = true (default do binário já é true; declarado aqui
# explicitamente). Só vira false em dev local sem TLS.
PAYMENT_SECURE_COOKIES=true

# --- Persistência --------------------------------------------------------------
# PostgreSQL no cluster compartilhado (data.lmhost, rede privada 172.18.0.0/20).
# Contém estado financeiro: pagamentos, ledger, eventos anti-replay, pix_rec e os
# segredos selados. As migrations rodam a cada boot, protegidas pelo ledger
# schema_migrations.
#
# O host é o IP PRIVADO, nunca data.lmhost.com.br: o hostname resolve para o IP
# público (201.23.19.42) e o PostgreSQL só escuta em 127.0.0.1 e 172.18.2.248.
# Usar o hostname dá timeout de conexão, não erro de nome — o modo de falha mais
# lento de diagnosticar.
#
# sslmode=require não é opcional: a conexão atravessa a VLAN. A senha vem do Vault
# (minio:8200), materializada em /run/payment/env pelo ExecStartPre — nunca em disco
# persistente, nunca em repo.
#
# Definir isto DESLIGA o SQLite. Deixe PAYMENT_DB_PATH fora do arquivo para que um
# erro de digitação no DSN falhe o boot em vez de abrir um arquivo local vazio.
PAYMENT_DB_DSN=<vault:prod/payment/db-dsn>

# --- Autenticação: tokens de PRODUÇÃO (least-privilege, rotacionáveis) ----------
# SEGREDOS — vêm do vault, injetados no ambiente. NUNCA em repo. Rotacionáveis.
# ADMIN = acesso total (cria tenant, escreve credencial/cert bancário, preço).
# OPERATOR = somente-leitura. Um token em ambas as listas mantém o papel mais
# forte — mantenha listas disjuntas (least privilege).
PAYMENT_ADMIN_TOKENS=<vault:prod/payment/admin-tokens>
PAYMENT_OPERATOR_TOKENS=<vault:prod/payment/operator-tokens>
# Mapa "token:tenantID" do bearer do tenant em /v1/*. tenantID = id (32 hex) de
# POST /admin/tenants. SEGREDO — vault.
PAYMENT_TENANT_TOKENS=<vault:prod/payment/tenant-tokens>

# --- Webhook C6 (capability-URL por tenant) ------------------------------------
# Base pública onde o C6 chama de volta. PROD = domínio real com TLS.
PAYMENT_WEBHOOK_BASE_URL=https://payment.<dominio-prod>
# Mapa "ref:tenantID" — ref opaca (43 chars base64url) que compõe o path opaco
# /webhooks/c6/{ref}. SEGREDO (capability-URL) — vault. Ingress MASCARA o path no
# log; dedup por event_key ativo (go-live C6 2026-06-13).
PAYMENT_WEBHOOK_REFS=<vault:prod/payment/webhook-refs>

# --- Cliente C6 de PRODUÇÃO ----------------------------------------------------
# VAZIO = adapter stub in-memory (dev/staging). PROD EXIGE as URLs reais; é o
# flip que "liga" o tráfego real ao C6 (e o principal ponto de rollback §5).
PAYMENT_C6_BASE_URL=https://<host-api-prod-c6>
PAYMENT_C6_TOKEN_URL=https://<host-oauth-prod-c6>/token
PAYMENT_C6_SCOPE=<escopos conforme contrato de PRODUÇÃO>
# Timeout de chamada C6. Revisar contra o SLO de prod. Default do binário: 15s.
PAYMENT_C6_TIMEOUT=15s

# mTLS de CANAL com o C6 (cert/chave do NOSSO cliente no canal C6 prod). Arquivos
# PEM com permissão 0600 e owner do processo (runbook mTLS SIN-65916/66087).
# Os PATHS podem ficar aqui; o CONTEÚDO da chave é segredo (nunca no repo).
# NB: distinto da credencial do CLIENTE por (tenant,bank), que vai no cofre via
# console — não neste env.
PAYMENT_C6_CLIENT_CERT=/etc/payment/c6/prod/client.crt
PAYMENT_C6_CLIENT_KEY=/etc/payment/c6/prod/client.key
# JWKS do C6 para verificar JWS das leituras de recorrência (PIX Automático,
# SIN-66061). PROD = endpoint JWKS de produção do C6.
PAYMENT_C6_REC_JWKS_URL=https://<host-api-prod-c6>/.well-known/jwks.json

# --- Rate-limit OUTBOUND ao C6 (token-bucket + backoff, SIN-68742) -------------
# Protege contra estourar a quota do C6; retry só em 429/503 com Retry-After.
# 0 = desligado (default). PROD = ligar conforme a quota contratada de prod.
PAYMENT_C6_RATE_LIMIT_RPS=<rps conforme quota prod, ex. 10>
PAYMENT_C6_RATE_LIMIT_BURST=<burst conforme quota prod, ex. 20>
# Máx. de retries por chamada (só 429/503). 0 = single-shot. Revisar p/ SLO prod.
PAYMENT_C6_MAX_RETRIES=<ex. 2>

# --- Credenciais bancárias por (tenant,bank) -----------------------------------
# ⚠️ Preferir o intake pelo CONSOLE (cofre write-only, keyed (tenant,bank)) para
# a credencial de produção do cliente — NÃO via env. Estas vars existem para
# bootstrap/dev; em prod o segredo do cliente entra pelo operador no console
# (runbook §1). Se usadas, vêm do vault. Formato/uso: ver `.env.example`.
# PAYMENT_BANK_CREDS=<vault — NÃO usar em prod para segredo do cliente>
# PAYMENT_BANK_CREDITOR_KEYS=<tenantID:chave-pix-recebedor>

# --- Mensageria (opcional) -----------------------------------------------------
# Vazio = sem publisher externo. Se usado em prod, vem do vault.
PAYMENT_RABBIT_URL=
