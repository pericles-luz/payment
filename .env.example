# =============================================================================
# payment — template de configuração (SIN-65346)
# =============================================================================
# COPIE para `.env` (gitignored) e preencha SOMENTE em dev local. NUNCA commite
# `.env`. Em homologação/produção, NENHUM destes valores vem de arquivo: os
# SEGREDOS (tokens, refs de webhook, credenciais bancárias) vêm do secret
# manager / vault, injetados no ambiente do processo no deploy. Este arquivo
# documenta o SHAPE das variáveis — todos os valores abaixo são placeholders
# NÃO-secretos e inseguros por construção (não use em produção).
#
# Regra C1 (ver cabeçalho de internal/platform/config/config.go): segredo nunca
# vem de código nem de URL. A fonte é config.FromEnv() — esta é a lista completa.
#
# Secure-by-default: os defaults aqui mantêm os controles de segurança LIGADOS.
# A única exceção de dev (PAYMENT_SECURE_COOKIES=false) está comentada e
# explicada; deixe-a comentada para herdar o default seguro (true).
# =============================================================================

# --- Transporte HTTP -----------------------------------------------------------
# Endereço de escuta. A app roda HTTP puro ATRÁS de um proxy que termina TLS
# (ver docs/ops/ingress-runbook.md). Default: ":8080".
PAYMENT_HTTP_ADDR=:8080

# --- Persistência --------------------------------------------------------------
# Dois motores. PAYMENT_DB_DSN definido => PostgreSQL, e PAYMENT_DB_PATH é
# IGNORADO. Vazio => SQLite no caminho abaixo. Nessa ordem de propósito: uma
# instância apontada para o cluster nunca pode cair de volta para um arquivo local
# — ele subiria vazio, o que se parece com perda de dados.
#
# Dev e CI usam o SQLite (sem servidor, sem container). O deploy usa o Postgres.
# Qualquer um dos dois guarda estado financeiro: pagamentos, ledger, eventos
# processados (anti-replay do webhook C6) e os segredos selados.
PAYMENT_DB_PATH=payment.db
# PAYMENT_DB_DSN=postgres://payment:senha@data.lmhost.com.br:5432/payment?sslmode=require

# --- Autenticação do plano tenant (API /v1) ------------------------------------
# Mapa "token:tenantID,token2:tenantID2". O bearer do tenant em /v1/charges
# resolve para o tenantID via este mapa. SEGREDO — venha do secret manager.
# O tenantID é o id (32 hex) retornado por POST /admin/tenants.
# Placeholder (NÃO use):
PAYMENT_TENANT_TOKENS=tnt-REPLACE-ME:00000000000000000000000000000000

# --- Autenticação do plano admin (RoleAdmin / RoleOperator) --------------------
# Listas separadas por vírgula. ADMIN = acesso total (cria tenant, escreve
# credencial bancária, define preço). OPERATOR = somente-leitura (least
# privilege). Um token que apareça nas duas listas mantém o papel mais forte
# (admin). SEGREDOS — do secret manager.
PAYMENT_ADMIN_TOKENS=adm-REPLACE-ME
PAYMENT_OPERATOR_TOKENS=ops-REPLACE-ME

# --- Webhook C6: refs opacas por-tenant (capability-URL) -----------------------
# Mapa "tenantRef:tenantID,...". O webhook C6 NÃO é assinado: a ref opaca
# embutida na URL /webhooks/c6/{tenantRef} É a credencial por-tenant
# (ADR-0002/F4). Cada ref é um token base64url de 43 chars (256 bits).
#
# Como obter a ref: gere com httpadapter.GenerateTenantRef() (CSPRNG) ou, em
# dev, com:   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Registre no portal C6 a URL completa do tenant:
#   https://<seu-dominio>/webhooks/c6/<tenantRef>
# A ref é SEGREDO: nunca logue a ref nem a URL completa. O edge DEVE mascarar o
# path de /webhooks/c6/* nos access logs (docs/ops/ingress-runbook.md §6/§7).
# Refs malformadas são descartadas (failure-closed).
PAYMENT_WEBHOOK_REFS=REPLACE-43-char-base64url-ref:00000000000000000000000000000000

# Origem pública do receptor usada por cmd/register-webhook (SIN-65908) para montar
# a URL de callback registrada no C6: <base>/webhooks/c6/<tenantRef>. Opcional;
# default https://payment.lmhost.com.br. NÃO é segredo (a ref no path é que é).
PAYMENT_WEBHOOK_BASE_URL=https://payment.lmhost.com.br

# --- Credenciais bancárias por-(tenant, banco) (OAuth2 client_credentials) -------
# Forma CANÔNICA de 4 campos "tenant:banco:clientID:secret,..." (o slug do banco —
# ex. `c6` — vem ANTES do clientID; ADR-0007). O secret é a cauda greedy `:`-
# tolerante (último campo), então um secret com ':' é preservado verbatim.
#
# ⚠️ A forma legada de 3 campos "tenant:clientID:secret" ainda é aceita e assume
# banco `c6`, MAS um secret legado que contém ':' é AMBÍGUO — parseia como a forma
# de 4 campos (o clientID é lido como o slug do banco). Falha FECHADA (slot órfão
# => nenhum token mintado, sem leak), porém silenciosa. SEMPRE escreva a forma
# explícita de 4 campos com `c6`. Confira no startup o log `loaded bank
# credentials` (só os pares (tenant, banco) não-secretos) para detectar misparse.
# SEGREDO — do secret manager. Alternativa em runtime: o secret store in-memory
# também é populado por PUT /admin/tenants/{id}/bank-credential (write-only).
PAYMENT_BANK_CREDS=00000000000000000000000000000000:c6:c6-client-REPLACE:c6-secret-REPLACE

# Chave PIX do recebedor (chave do recebedor) por tenant, injetada pelo adapter
# na cob/cobv quando o request não a traz (opção (a); ADR-0004 / SIN-65862).
# Formato "tenant:creditorKey,..." (uma chave PIX não contém ':', split no
# primeiro ':' apenas). Variável SEPARADA de PAYMENT_BANK_CREDS para não colidir
# com o secret greedy `:`-tolerante. NÃO é segredo (id PIX público da conta), mas
# É sensível a roteamento de fundos: nunca é logada. Entradas malformadas, ou para
# um tenant sem credencial bancária, são puladas e logadas (sem vazar a chave).
PAYMENT_BANK_CREDITOR_KEYS=00000000000000000000000000000000:recebedor-REPLACE@pix.example

# --- Barramento de mensagens (opcional) ----------------------------------------
# URL do RabbitMQ. Vazio => barramento in-memory (dev/test). Em prod aponte para
# o broker. Pode conter credencial — trate como SEGREDO.
PAYMENT_RABBIT_URL=

# --- Cookies seguros (controle de segurança) -----------------------------------
# Atributo Secure nos cookies que a app emite (token CSRF; cookie de sessão do
# console). Decisão de DEPLOY, não por-request: TLS termina no proxy, então
# r.TLS é sempre nil e X-Forwarded-Proto é spoofável — só a config é confiável.
# Default: true (secure-by-default). DEIXE COMENTADO para herdar o default.
# Exceção SOMENTE para dev local em http:// puro (descomente, ciente do risco):
# PAYMENT_SECURE_COOKIES=false

# --- Adaptador bancário C6 (transporte OAuth2/HTTPS) ---------------------------
# BaseURL VAZIO => a app sobe com o stub bancário in-memory (dev/test); é isso
# que viabiliza o smoke E2E sem o C6 real (ver docs/ops/c6-smoke-e2e-runbook.md).
# Preencha com os endpoints de homologação quando as credenciais do C6 chegarem
# (SIN-65344). O adaptador REJEITA endpoints não-HTTPS (secure-by-default): uma
# URL http:// falha o startup em vez de degradar o transporte silenciosamente.
PAYMENT_C6_BASE_URL=
PAYMENT_C6_TOKEN_URL=
PAYMENT_C6_SCOPE=
# Timeout por-request do cliente HTTP C6 (ex: "20s", "1m"). Default: 15s.
PAYMENT_C6_TIMEOUT=15s

# --- Certificado de cliente mTLS do C6 (SIN-65805) -----------------------------
# O C6 exige um certificado de cliente (mutual TLS) na conexão, ALÉM do bearer
# OAuth2. Estas vars são CAMINHOS para arquivos PEM — o SEGREDO (a chave privada)
# vive só no arquivo, NUNCA em código, no valor da env, ou em URL (threat C1).
# Ambas VAZIAS => sem certificado de cliente (comportamento atual preservado: ok
# para stub/dev). Setar UMA sem a outra falha o boot (fail-closed) — é melhor um
# erro explícito no startup do que conectar silenciosamente sem o cert.
# O par é carregado com tls.LoadX509KeyPair; TLS >= 1.2 e redirects desabilitados
# (anti-SSRF) são preservados (ver c6.MTLSHTTPClient).
#   PAYMENT_C6_CLIENT_CERT=/etc/payment/c6/client.crt   # PEM do certificado
#   PAYMENT_C6_CLIENT_KEY=/etc/payment/c6/client.key    # PEM da chave privada
# Em homologação/produção os arquivos vêm do secret manager (montados read-only
# no FS do processo), não do repositório. Deixe VAZIO em stub/dev.
PAYMENT_C6_CLIENT_CERT=
PAYMENT_C6_CLIENT_KEY=

# --- JWKS de verificação das leituras de Recorrência / PIX Automático (SIN-66061) ---
# As leituras rec/solicrec/cobr (GET, Accept: application/jose) vêm assinadas em JWS
# para não-repúdio do mandato BACEN. Esta é a URL https do JWKS do C6 de onde o
# verificador busca as CHAVES PÚBLICAS (por kid, com rotação) para validar a
# assinatura ANTES de confiar no corpo. É uma URL, NUNCA um segredo — só chaves
# públicas trafegam por ela. O verificador exige https (anti-SSRF, TLS-only): uma
# URL http:// falha o boot. Allowlist assimétrica explícita (PS256/ES256); alg:none
# e HS* (MAC simétrico) são REJEITADOS (defesa key-confusion).
# VAZIO => as leituras de recorrência falham SEGURO (ErrUnavailable): a recorrência
# fica desligada até go-live (F4), em vez de confiar em documento não-verificado.
# Quando o C6 serve o JWKS atrás do mesmo mTLS, o cert de cliente acima é reutilizado.
# Procedimento de go-live (confirmar fonte, fixar allowlist, ligar esta var):
# docs/ops/c6-recurrence-jws-go-live-runbook.md (F4, SIN-66066).
#   PAYMENT_C6_REC_JWKS_URL=https://api.c6bank.example/.well-known/jwks.json
PAYMENT_C6_REC_JWKS_URL=

# Tenant designado para o fetch do JWKS quando o endpoint está atrás do mTLS por
# COFRE (SIN-69375). O fetch do JWKS é process-wide e não carimba tenant, então num
# transporte mTLS vault-only (sem cert bootstrap §8) ele apresentaria cert vazio e o
# handshake falharia fechado — quebrando a verificação de recorrência. Setar esta var
# com um tenant cujo certificado no cofre satisfaz o mTLS do JWKS faz o fetch
# apresentar esse cert. VAZIO (default) mantém o comportamento anterior (tenantless =>
# cert §8, ou nenhum). Só tem efeito com JWKS atrás de mTLS; num JWKS público é inerte.
# Alternativa operacional: manter PAYMENT_C6_CLIENT_CERT/_KEY (§8) configurado.
#   PAYMENT_C6_REC_JWKS_MTLS_TENANT=tenant-verz
PAYMENT_C6_REC_JWKS_MTLS_TENANT=

# --- Carteira de cobrança do BolePix (SIN-69580) --------------------------------
# Código da carteira enviado em toda emissão de boleto (`payment_method.bank_slip.
# billing_scheme`). É DEPENDENTE DE AMBIENTE: o C6 documenta a carteira 15 em
# produção e a 21 no sandbox. Por isso é configuração, nunca constante — apontar o
# ambiente errado registra a cobrança na carteira errada, em silêncio. VAZIO usa o
# default do adapter (15, produção).
#   PAYMENT_C6_BILLING_SCHEME=21    # sandbox
PAYMENT_C6_BILLING_SCHEME=
